@page "/weather"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Pogoda</PageTitle>

<h1>Prognoza pogody</h1>

<p>Liczba ciepłych dni (>15°C): <b>@warmDaysCount</b></p>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" @oninput="OnSearchInput" placeholder="Filtruj po nazwie..." />
    <button class="btn btn-primary" @onclick="WarmDaysFilter">Tylko ciepłe</button>
    <button class="btn btn-secondary" @onclick="Restore">Reset</button>
</div>

@if (forecasts == null)
{
    <p><em>Ładowanie...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Data</th>
                <th>Temp. (C)</th>
                <th>Opis</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private WeatherForecast[]? forecasts;
    private WeatherForecast[]? originalForecasts;
    private int warmDaysCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        var startDate = DateOnly.FromDateTime(DateTime.Now);
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };
        
        // ZADANIE: Wydłużenie do 10 dni
        forecasts = Enumerable.Range(1, 10).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).ToArray();

        originalForecasts = forecasts;
        CountWarmDays();
    }

    private void CountWarmDays() 
    {
        warmDaysCount = forecasts?.Count(f => f.TemperatureC > 15) ?? 0;
    }

    private void WarmDaysFilter()
    {
        forecasts = originalForecasts?.Where(f => f.TemperatureC >= 15).ToArray();
        CountWarmDays();
    }

    private void Restore()
    {
        forecasts = originalForecasts;
        CountWarmDays();
    }

    private void OnSearchInput(ChangeEventArgs arg)
    {
        string filter = arg.Value?.ToString() ?? "";
        forecasts = originalForecasts?.Where(f => f.Summary!.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToArray();
        CountWarmDays();
    }

    private class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
    }
}